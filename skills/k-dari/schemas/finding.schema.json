{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "K-DARI Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "statement", "claim_type", "classification", "evidence_ids", "confidence", "jurisdiction", "as_of_date"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^FN-[A-Z0-9-]+$"},
    "statement": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["LAW_EFFECTIVE", "LAW_PROMULGATED_NOT_EFFECTIVE", "BILL_PROPOSED", "REGULATION_DRAFT", "POLICY_ANNOUNCEMENT", "REGULATORY_GUIDANCE", "BUSINESS_MODEL_FACT", "BUSINESS_APPLICABILITY_INFERENCE", "OTHER_FACT"]},
    "classification": {"enum": ["VERIFIED_FACT", "SUPPORTED_INFERENCE", "UNVERIFIED", "NEEDS_REVIEW"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"}, "uniqueItems": true},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "rationale": {"type": "string"},
    "jurisdiction": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "provision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"enum": ["VERIFIED_FACT", "SUPPORTED_INFERENCE"]}}},
      "then": {"properties": {"evidence_ids": {"minItems": 1}}}
    }
  ]
}

